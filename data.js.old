window.BOOK_DATA = [
{"id": "calendula_arvensis", "title": "151. أقحوان الحقول (Calendula arvensis)", "darja": "الجمرة (Jemra)", "tamazight": "Iloudi (à vérifier)", "latin": "Calendula arvensis L.", "french": "Souci des champs", "content": "نبات عشبي حولي من الفصيلة النجمية، أزهاره برتقالية صفراء، ينمو في الحقول والبور. يُجمع في الربيع.\nمضاد للالتهابات، معالج للجروح والقروح الجلدية، مهدئ للتشنجات المعوية، منشط للدورة الدموية.\nمنقوع 1 ملعقة صغيرة من الأزهار المجففة في كوب ماء مغلي لمدة 10 دقائق، 2–3 أكواب يومياً. للاستعمال الخارجي: كمادات من المنقوع المركز على الجروح.\nآمن عموماً، لكن يُنصح بتجنبه للحوامل والمرضعات دون استشارة.", "image": "images/calendula_arvensis.jpg"},
{"id": "silybum_marianum", "title": "152. شوك الحليب (Silybum marianum)", "darja": "شوك النصارى (Chouk ennassara)", "tamazight": "⚠️ à vérifier", "latin": "Silybum marianum (L.) Gaertn.", "french": "Chardon-Marie", "content": "نبات شوكي من الفصيلة النجمية، أوراقه مبقعة بالأبيض، أزهاره بنفسجية.\nحماية الكبد وتجديد خلاياه (بفضل السيليمارين)، علاج تليف الكبد واليرقان، خفض الكوليسترول، دعم مرضى السكري من النوع 2.\nمسحوق البذور المطحونة: نصف ملعقة صغيرة في كوب ماء دافئ، مرة إلى مرتين يومياً قبل الأكل.\nآمن بجرعات معتدلة. قد يسبب إسهالاً خفيفاً في البداية.", "image": "images/silybum_marianum.jpg"},
{"id": "achillea_millefolium", "title": "153. حزبل (Achillea millefolium)", "darja": "⚠️ à vérifier", "tamazight": "⚠️ à vérifier", "latin": "Achillea millefolium L.", "french": "Achillée millefeuille", "content": "عشبة معمرة ذات أوراق ريشية دقيقة وأزهار بيضاء في خياميات.\nقابض، موقف للنزيف، خافض للحرارة، مضاد للتشنج، منظم للدورة الشهرية.\nمنقوع 1 ملعقة صغيرة من الأوراق والأزهار في كوب ماء مغلي، 10 دقائق، 2–3 مرات يومياً.\nيُمنع للحوامل (منبه للرحم). قد يسبب حساسية جلدية عند بعض الأشخاص.", "image": "images/achillea_millefolium.jpg"},
{"id": "malva_sylvestris2", "title": "154. خبازة برية (Malva sylvestris)", "darja": "الخبيزة (L-khubiza)", "tamazight": "⚠️ à vérifier", "latin": "Malva sylvestris L.", "french": "Mauve sauvage", "content": "عشبة حولية أو معمرة بأوراق دائرية مسننة وأزهار بنفسجية.\nملينة ومهدئة للأمعاء، مدرة للبول، مضادة للالتهابات، مسكنة للسعال، مفيدة لعسر الهضم والقولون العصبي.\nمنقوع 1 ملعقة كبيرة من الأوراق في كوب ماء مغلي، 10 دقائق، 2–3 أكواب يومياً. للغرغرة: منقوع مركز.\nآمنة. الإفراط قد يسبب ليناً في الأمعاء.", "image": "images/malva_sylvestris.jpg"},
{"id": "plantago_lanceolata", "title": "155. لسان الحمل (Plantago lanceolata)", "darja": "لسان الحمل (Lissane el haml)", "tamazight": "⚠️ à vérifier", "latin": "Plantago lanceolata L.", "french": "Plantain lancéolé", "content": "عشبة معمرة بأوراق رمحية طويلة وأزهار بنية في سنابل.\nقابض، مضاد للالتهابات، معالج للسعال والتهابات الجهاز التنفسي، شافٍ للجروح، مضاد للبكتيريا.\nمنقوع 1 ملعقة كبيرة من الأوراق المجففة في كوب ماء مغلي، 10 دقائق، 3 مرات يومياً.\nآمن. يُنصح بشرب كمية كافية من الماء معه.", "image": "images/plantago_lanceolata.jpg"},
{"id": "urtica_dioica2", "title": "156. حريق / القراص (Urtica dioica)", "darja": "الحرايق (L-hrayeg)", "tamazight": "Tikzinin", "latin": "Urtica dioica L.", "french": "Ortie dioïque", "content": "عشبة معمرة مغطاة بشعيرات لاذعة، أوراقها مسننة.\nمغذٍّ غني بالحديد والكالسيوم، مدر للبول، منظف للدم، مضاد للروماتيزم، مفيد لفقر الدم، منشط للدورة الدموية.\nمنقوع 1 ملعقة كبيرة من الأوراق المجففة في كوب ماء مغلي، 10 دقائق، 2–3 مرات يومياً (تفقد الشعيرات اللاذعة بعد التجفيف أو السلق).\nيُمنع للحوامل. قد يتفاعل مع مدرات البول.", "image": "images/urtica_dioica.jpg"},
{"id": "viola_odorata", "title": "157. بنفسج (Viola odorata)", "darja": "⚠️ à vérifier", "tamazight": "⚠️ à vérifier", "latin": "Viola odorata L.", "french": "Violette odorante", "content": "نبات صغير معمر بأزهار بنفسجية عطرية.\nمهدئ للسعال، طارد للبلغم، مضاد للالتهابات، ملطف للجلد، مسكن للصداع.\nمنقوع 1 ملعقة صغيرة من الأزهار في كوب ماء مغلي، 5 دقائق، 2–3 مرات يومياً.\nآمن. يُمنع من يستعملون أدوية مضادة للتخثر دون استشارة.", "image": "images/viola_odorata.jpg"},
{"id": "papaver_rhoeas", "title": "158. شقائق النعمان (Papaver rhoeas)", "darja": "البلعمان (Bela'man)", "tamazight": "⚠️ à vérifier", "latin": "Papaver rhoeas L.", "french": "Coquelicot", "content": "نبات حولي بأزهار حمراء زاهية، ينمو في الحقول.\nمهدئ خفيف، مسكن للسعال، ملطف للجهاز التنفسي، مضاد للتشنج.\nمنقوع 1 ملعقة صغيرة من البتلات في كوب ماء مغلي، 10 دقائق، 2 مرات يومياً.\nيُمنع للأطفال الصغار والحوامل. الجرعات العالية قد تسبب النعاس.", "image": "images/papaver_rhoeas.jpg"},
{"id": "parietaria_officinalis", "title": "159. حشيشة الجدران (Parietaria officinalis)", "darja": "⚠️ à vérifier", "tamazight": "⚠️ à vérifier", "latin": "Parietaria officinalis L.", "french": "Pariétaire officinale", "content": "عشبة معمرة تنمو على الجدران والصخور، أوراقها بيضية.\nمدر قوي للبول، معالج لحصى الكلى والمثانة، مضاد للالتهابات البولية، ملين.\nمنقوع 1 ملعقة كبيرة من الأوراق في كوب ماء مغلي، 10 دقائق، 3 أكواب يومياً.\nيُمنع في حالات احتباس السوائل بسبب مشاكل قلبية أو كلوية.", "image": "images/parietaria_officinalis.jpg"},
{"id": "borago_officinalis", "title": "160. لسان الثور (Borago officinalis)", "darja": "⚠️ à vérifier", "tamazight": "⚠️ à vérifier", "latin": "Borago officinalis L.", "french": "Bourrache", "content": "نبات حولي بأوراق خشنة وأزهار زرقاء نجمية.\nمضاد للالتهابات، منشط للغدد الكظرية، مضاد للاكتئاب الخفيف، مدر للبول، ملين.\nمنقوع 1 ملعقة صغيرة من الأزهار أو الأوراق في كوب ماء مغلي، 10 دقائق، 2–3 مرات يومياً.\nيُمنع للحوامل والمرضعات (يحتوي على قلويدات كبدية). الاستعمال المطول غير مُنصح به.", "image": "images/borago_officinalis.jpg"},
{"id": "capsella_bursa-pastoris", "title": "161. كيس الراعي (Capsella bursa-pastoris)", "darja": "⚠️ à vérifier", "tamazight": "⚠️ à vérifier", "latin": "Capsella bursa-pastoris (L.) Medik.", "french": "Bourse-à-pasteur", "content": "نبات حولي صغير بثمار مثلثة الشكل تشبه كيس الراعي.\nموقف للنزيف، قابض، مدر للبول، منظم للدورة الشهرية.\nمنقوع 1 ملعقة صغيرة من العشبة المجففة في كوب ماء مغلي، 10 دقائق، 2–3 مرات يومياً.\nيُمنع للحوامل. قد يتفاعل مع أدوية ضغط الدم.", "image": "images/capsella_bursa-pastoris.jpg"},
{"id": "lepidium_sativum", "title": "162. رشاد (Lepidium sativum)", "darja": "حب الرشاد (Hb rrachad)", "tamazight": "⚠️ à vérifier", "latin": "Lepidium sativum L.", "french": "Cresson alénois", "content": "نبات حولي سريع النمو، أوراقه ريشية وبذوره حمراء صغيرة.\nمنشط جنسي، مدر للبول، طارد للغازات، مقوٍّ للعظام، مفيد للربو والسعال، خافض لسكر الدم.\nمسحوق البذور: نصف ملعقة صغيرة مع العسل أو الحليب، مرة يومياً. أو منقوع البذور في ماء دافئ ليلة كاملة.\nيُمنع للحوامل (منبه للرحم). الإفراط قد يسبب اضطرابات هضمية.", "image": "images/lepidium_sativum.jpg"}
];
